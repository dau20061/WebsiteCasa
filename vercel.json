{
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "backend/**"
    },
    "api/*.js": {
      "includeFiles": "backend/**"
    }
  }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}