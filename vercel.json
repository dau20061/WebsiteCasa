{
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**": {
      "includeFiles": "backend/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!product-image/|article-image/).*\\.(?:ico|png|jpg|jpeg|webp|svg|woff2|avif))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },
    {
      "source": "/product-image/(.*)",
      "destination": "/api/product-image.js?slug=$1"
    },
    {
      "source": "/article-image/(.*)",
      "destination": "/api/article-image.js?slug=$1"
    },
    {
      "source": "/api/products/(.+)",
      "destination": "/api/[...path].js?path=products/$1"
    },
    {
      "source": "/api/news/(.+)",
      "destination": "/api/[...path].js?path=news/$1"
    },
    {
      "source": "/api/categories/(.+)",
      "destination": "/api/[...path].js?path=categories/$1"
    },
    {
      "source": "/api/faq/(.+)",
      "destination": "/api/[...path].js?path=faq/$1"
    },
    {
      "source": "/api/faqs/(.+)",
      "destination": "/api/[...path].js?path=faqs/$1"
    },
    {
      "source": "/api/contacts/(.+)",
      "destination": "/api/[...path].js?path=contacts/$1"
    },
    {
      "source": "/api/users/(.+)",
      "destination": "/api/[...path].js?path=users/$1"
    },
    {
      "source": "/api/ai/(.+)",
      "destination": "/api/[...path].js?path=ai/$1"
    },
    {
      "source": "/((?!assets/|api/|robots\\.txt|sitemap\\.xml|site\\.webmanifest|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}