{
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**": {
      "includeFiles": "backend/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|webp|svg|woff2|avif))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "/api/products.js"
    },
    {
      "source": "/api/news",
      "destination": "/api/news.js"
    },
    {
      "source": "/api/categories",
      "destination": "/api/categories.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].js?path=$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },
    {
      "source": "/product-image/(.*)",
      "destination": "/api/product-image.js?slug=$1"
    },
    {
      "source": "/article-image/(.*)",
      "destination": "/api/article-image.js?slug=$1"
    },
    {
      "source": "/((?!api/|robots\\.txt|product-image/|article-image/).*)",
      "destination": "/index.html"
    }
  ]
}