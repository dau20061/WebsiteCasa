{
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },
    {
      "source": "/product-image/(.*)",
      "destination": "/api/product-image.js?slug=$1"
    },
    {
      "source": "/article-image/(.*)",
      "destination": "/api/article-image.js?slug=$1"
    },
    {
      "source": "/((?!api/|robots\\.txt|product-image/|article-image/).*)",
      "destination": "/index.html"
    }
  ]
}